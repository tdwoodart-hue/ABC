rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /couples/{coupleId} {
      allow read, write: if request.auth != null;
    }
    match /couples/{coupleId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
