rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAllowedEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in [
          'tdwoodart@gmail.com',
          'duong@gmail.com',
          'chucga@gmail.com'
        ];
    }

    // Private couple app.
    // Only these three authenticated accounts may access Firestore.
    match /couples/{coupleId}/scheduled_messages/{messageId} {
      allow create: if hasAllowedEmail() && request.resource.data.senderUid == request.auth.uid;
      allow read: if hasAllowedEmail() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow update, delete: if false;
    }
    match /scheduled_message_keys/{messageId} { allow read, write: if false; }
    match /users/{userId} {
      allow read, write: if hasAllowedEmail();
    }
    match /couples/{coupleId} {
      allow read, write: if hasAllowedEmail();
    }
    match /couples/{coupleId}/{collectionId}/{document=**} {
      allow read, write: if hasAllowedEmail() && collectionId != 'scheduled_messages';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
